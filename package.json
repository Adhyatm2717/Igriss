{
  "name": "igriss",
  "version": "0.1.0",
  "private": true,
  "description": "Igriss desktop application",
  "main": "src/main/index.cjs",
  "scripts": {
    "dev": "concurrently -k \"vite --config vite.config.js\" \"wait-on tcp:5173 && cross-env VITE_DEV_SERVER_URL=http://127.0.0.1:5173 electron .\"",
    "build": "vite build --config vite.config.js",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "react": "latest",
    "react-dom": "latest"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "latest",
    "@tailwindcss/vite": "latest",
    "concurrently": "latest",
    "cross-env": "latest",
    "electron": "latest",
    "tailwindcss": "latest",
    "vite": "latest",
    "vitest": "latest",
    "wait-on": "latest"
  }
}
